# ==============================================================================
# VertiCare AI - Environment Configuration Template (.env.example)
# DO NOT place actual secrets or production passwords in this file.
# Copy this file to .env and adjust variables for your local development environment.
# ==============================================================================

# Application Environment
APP_NAME="VertiCare AI"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & Tokens (Use a strong generated secret for local .env)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verticare_db
POSTGRES_USER=verticare_user
POSTGRES_PASSWORD=verticare_password

# Database URLs
# For Local Development / Docker Compose:
DATABASE_URL=postgresql://verticare_user:verticare_password@localhost:5432/verticare_db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="VertiCare AI"

